# Backend Environment Variables

# Database
MONGODB_URI=your-mongodb-connection-string

# JWT Secrets (IMPORTANT: Use different, strong secrets for each)
AUTH_SECRET=your-jwt-secret-key-for-access-tokens
REFRESH_TOKEN_SECRET=your-different-refresh-token-secret-key

# Frontend URL for CORS
# For development: not needed (defaults to localhost:5173)
# For production: https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Server Port
PORT=5000

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_REGION=auto

# Deepgram API
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_PROJECT_ID=your-deepgram-project-id

# Google OAuth (if used in backend)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS Polly Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Node Environment
NODE_ENV=development
